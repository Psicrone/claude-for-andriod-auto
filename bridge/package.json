{
  "name": "claude-auto-bridge",
  "version": "0.2.0",
  "description": "HTTP bridge that lets the Claude Auto Android app talk to Claude Code sessions on your machine",
  "type": "module",
  "private": true,
  "bin": {
    "claude-auto-bridge": "dist/server.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "dev": "tsc -p tsconfig.json && node dist/server.js",
    "test": "tsc -p tsconfig.json && node --test dist/test/*.test.js",
    "pair": "node dist/server.js --pair",
    "devices": "node dist/server.js devices"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.311",
    "selfsigned": "^5.5.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "typescript": "^5.9.3"
  }
}
