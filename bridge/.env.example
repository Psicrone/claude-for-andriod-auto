# Address to listen on. Your Tailscale IP (100.x.y.z) or LAN IP lets the phone reach it;
# 0.0.0.0 listens everywhere. Every connection is HTTPS and only paired phones get in.
BRIDGE_HOST=0.0.0.0
BRIDGE_PORT=8787

# HTTPS: "self-signed" (default) creates a certificate on first run that the phone pins.
# "off" is only allowed with BRIDGE_HOST=127.0.0.1 behind something that adds HTTPS itself
# (Tailscale Serve, a Cloudflare tunnel).
BRIDGE_TLS=self-signed

# Where the certificate and paired phones are kept (default ~/.claude-auto-bridge).
BRIDGE_DATA_DIR=

# Projects you can start new conversations in, as name=path pairs separated by ";".
# The first one is the default.
BRIDGE_PROJECTS=work=/home/me/code/work-app;blog=/home/me/code/blog

# How Claude Code handles tool permissions while you drive:
#   ask         - risky tools (Bash, file edits, web) are read out and you approve by voice (default)
#   acceptEdits - file edits are allowed without asking; everything else is asked by voice
#   readonly    - only read/search tools; anything else is refused
BRIDGE_PERMISSIONS=ask

# Optional model override for Claude Code (leave empty to use your Claude Code default).
BRIDGE_MODEL=

# The address phones should use, when it isn't one of this machine's own addresses: a proxy
# in front of the bridge (https://pc.tail1234.ts.net) or a Docker port mapping. Goes in the QR code.
BRIDGE_PUBLIC_URL=
