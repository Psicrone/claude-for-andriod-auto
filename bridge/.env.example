# Shared secret the phone sends as "Authorization: Bearer <token>". Make it long and random:
#   node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
BRIDGE_TOKEN=change-me

# Address to listen on. Keep 127.0.0.1 if you put Tailscale Serve / a tunnel in front,
# or bind your Tailscale IP directly (for example 100.x.y.z).
BRIDGE_HOST=127.0.0.1
BRIDGE_PORT=8787

# Projects you can start new conversations in, as name=path pairs separated by ";".
# The first one is the default.
BRIDGE_PROJECTS=work=/home/me/code/work-app;blog=/home/me/code/blog

# How Claude Code handles tool permissions while you drive:
#   ask         - risky tools (Bash, file edits, web) are read out and you approve by voice (default)
#   acceptEdits - file edits are allowed without asking; everything else is asked by voice
#   readonly    - only read/search tools; anything else is refused
BRIDGE_PERMISSIONS=ask

# Optional model override for Claude Code (leave empty to use your Claude Code default).
BRIDGE_MODEL=
