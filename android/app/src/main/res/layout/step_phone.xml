<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    style="@style/Widget.ClaudeAuto.Step">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            style="@style/Widget.ClaudeAuto.StepTitle"
            android:text="@string/phone_title" />

        <TextView
            style="@style/Widget.ClaudeAuto.StepBody"
            android:text="@string/phone_body" />

        <include
            android:id="@+id/step1"
            layout="@layout/part_step_card" />

        <include
            android:id="@+id/step2"
            layout="@layout/part_step_card" />

        <include
            android:id="@+id/step3"
            layout="@layout/part_step_card" />

        <include
            android:id="@+id/manual"
            layout="@layout/part_manual_pairing" />
    </LinearLayout>
</ScrollView>
