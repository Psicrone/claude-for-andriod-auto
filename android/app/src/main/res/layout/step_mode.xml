<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    style="@style/Widget.ClaudeAuto.Step">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            style="@style/Widget.ClaudeAuto.StepTitle"
            android:text="@string/mode_title" />

        <TextView
            style="@style/Widget.ClaudeAuto.StepBody"
            android:text="@string/mode_body" />

        <include
            android:id="@+id/optionComputer"
            layout="@layout/item_mode" />

        <include
            android:id="@+id/optionPhone"
            layout="@layout/item_mode" />

        <include
            android:id="@+id/optionCloud"
            layout="@layout/item_mode" />
    </LinearLayout>
</ScrollView>
